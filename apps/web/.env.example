# Preferred configuration: the Next.js server proxies same-origin /api requests
# to the Express backend. Set this in both local and hosted web environments.
API_SERVER_URL="http://localhost:4000"

# Optional alternative: expose the API directly to the browser.
# When used, the Express CORS_ORIGINS value must include the web app origin.
# NEXT_PUBLIC_API_BASE="https://your-api.example.com"
