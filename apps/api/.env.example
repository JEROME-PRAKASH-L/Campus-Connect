# --- Local development ---------------------------------------------------
# Locally both URLs point at the same plain Postgres server.
DATABASE_URL="postgresql://campus:campus@localhost:5432/campus_connect?schema=public"
DIRECT_URL="postgresql://campus:campus@localhost:5432/campus_connect?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRY="12h"
PORT=4000
CORS_ORIGINS="http://localhost:3000"

# --- Deployed (Vercel + Supabase) ----------------------------------------
#
# DATABASE_URL — runtime queries. Use the *transaction* pooler (port 6543):
# serverless functions open far more short-lived connections than Postgres can
# absorb directly. `pgbouncer=true` stops Prisma emitting prepared statements,
# which that pooler does not support.
#
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
#
# DIRECT_URL — schema changes only (`prisma db push` during the build). DDL
# cannot run over the transaction pooler, so use the *session* pooler (port
# 5432). Supabase's db.<ref>.supabase.co host is IPv6-only and unreachable from
# many CI runners, which is why the session pooler is preferred here.
#
#   DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
#
# CORS_ORIGINS — the web app's real origin, comma-separated for more than one.
# "*" reflects any origin and disables credentialed CORS.
#
#   CORS_ORIGINS="https://your-web-app.vercel.app"
#
# FORCE_SEED=true reseeds on the next deploy, discarding existing data. Leave
# it unset: a deploy seeds automatically only when the database is empty.
