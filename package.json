{
  "name": "campus-connect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Root manifest for the Vercel deployment: the API's runtime dependencies live here so `api/` compiles as serverless functions alongside the static frontend.",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @campus-connect/api",
    "dev:web": "npm run dev --workspace @campus-connect/web",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm run build --workspace @campus-connect/api",
    "build:web": "npm run build --workspace @campus-connect/web",
    "test": "npm run test:api",
    "test:api": "npm run test --workspace @campus-connect/api",
    "vercel-build": "bash scripts/vercel-build.sh",
    "typecheck": "npm run typecheck:root && npm run typecheck:api && npm run typecheck:web",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "typecheck:api": "npm run typecheck --workspace @campus-connect/api",
    "typecheck:web": "npm run typecheck --workspace @campus-connect/web",
    "prisma:generate": "npm run prisma:generate --workspace @campus-connect/api",
    "db:push": "npm run prisma:push --workspace @campus-connect/api",
    "db:seed": "npm run seed --workspace @campus-connect/api"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
