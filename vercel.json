{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm install --prefix apps/api && npm install --prefix apps/web",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "apps/web/out",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...slug]?__path=/api/:path*"
    }
  ]
}
