# Copy to apps/api/.env and apps/web/.env.local, then fill in real values.
# Nothing in this file is a real credential — never commit a populated .env.

# ── API (apps/api/.env) ───────────────────────────────────────────────────────
DATABASE_URL="postgresql://campus:campus@localhost:5432/campus_connect?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRY="12h"
PORT=4000
CORS_ORIGINS="http://localhost:3000"

# Login throttling
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Object storage for documents and images. Only the URL and metadata are stored
# in PostgreSQL; the bytes live in the bucket.
#   STORAGE_DRIVER=s3     production — an S3-compatible bucket
#   STORAGE_DRIVER=local  development — writes under apps/api/.storage
STORAGE_DRIVER="local"
STORAGE_PUBLIC_BASE_URL="http://localhost:4000/files"
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ── Web (apps/web/.env.local) ─────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE="http://localhost:4000"
